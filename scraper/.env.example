# From Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# service_role key — SECRET, scraper writes only. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Per-source query. Each source gets its own — they are NOT interchangeable,
# and one value tuned for one site silently degrades the others. Both default
# to "ai" if unset. Brisbane + Ipswich locations are built in for every source.

# Luma discover *category slug* (must match a real Luma category).
LUMA_CATEGORY_SLUG=ai

# Meetup free-text *search keywords* (not a slug — spaces are fine).
MEETUP_KEYWORDS=ai
