# From Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# service_role key — SECRET, scraper writes only. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Luma discover category slug to pull (query-time topic filtering).
# Defaults to "ai". Brisbane + Ipswich coordinates are built in.
LUMA_CATEGORY_SLUG=ai
